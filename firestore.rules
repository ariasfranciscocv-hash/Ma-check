rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             request.auth.token.email == 'arias.francisco.cv@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validation Helpers ---
    function isValidUserProfile(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('branchName' in data) || data.branchName in ['Sucursal 107', 'Sucursal 109', 'Sucursal 110', 'Sucursal 112', 'Sucursal 148']) &&
             data.role in ['ADMIN', 'EMPLOYEE'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminRecord(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.grantedBy is string && isValidId(data.grantedBy) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidTask(data) {
      return data.assigneeId is string && isValidId(data.assigneeId) &&
             data.assigneeName is string && data.assigneeName.size() >= 1 && data.assigneeName.size() <= 80 &&
             data.createdBy is string && isValidId(data.createdBy) &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
             data.description is string && data.description.size() <= 500 &&
             data.taskType in ['DAILY', 'EXTRAORDINARY'] &&
             data.priority in ['NORMAL', 'URGENT'] &&
             data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('dueTime' in data) || (data.dueTime is string && data.dueTime.size() == 5 && data.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))) &&
             (!('deadlineLabel' in data) || (data.deadlineLabel is string && data.deadlineLabel.size() <= 80)) &&
             data.status in ['PENDING', 'COMPLETED'] &&
             data.hasPhotoEvidence is bool &&
             (!('evidenceId' in data) || (data.evidenceId is string && isValidId(data.evidenceId))) &&
             (!('completedAt' in data) || (data.completedAt is timestamp && data.completedAt <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTaskEvidence(data) {
      return data.taskId is string && isValidId(data.taskId) &&
             data.uploaderId is string && isValidId(data.uploaderId) &&
             data.uploaderName is string && data.uploaderName.size() >= 1 && data.uploaderName.size() <= 80 &&
             data.taskTitle is string && data.taskTitle.size() >= 1 && data.taskTitle.size() <= 120 &&
             data.imageBase64 is string && data.imageBase64.size() >= 50 && data.imageBase64.size() <= 700000 &&
             data.capturedAt is timestamp && data.capturedAt <= request.time;
    }

    function isValidNotification(data) {
      return data.recipientId is string && isValidId(data.recipientId) &&
             data.taskId is string && isValidId(data.taskId) &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
             data.message is string && data.message.size() >= 3 && data.message.size() <= 300 &&
             data.acknowledged is bool &&
             data.createdBy is string && isValidId(data.createdBy) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBiweeklyQuota(data) {
      return data.title is string && data.title.size() >= 3 && data.title.size() <= 80 &&
             data.startDate is string && data.startDate.size() == 10 && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.endDate is string && data.endDate.size() == 10 && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.totalDays is int && data.totalDays >= 1 && data.totalDays <= 31 &&
             data.targetGlobalSales is number && data.targetGlobalSales > 0 && data.targetGlobalSales <= 1000000000 &&
             data.targetCreditSales is number && data.targetCreditSales >= 0 && data.targetCreditSales <= 1000000000 &&
             data.targetNewCustomers is int && data.targetNewCustomers >= 0 && data.targetNewCustomers <= 100000 &&
             data.targetAppMaOperations is int && data.targetAppMaOperations >= 0 && data.targetAppMaOperations <= 100000 &&
             data.targetNewCustomerRequests is int && data.targetNewCustomerRequests >= 0 && data.targetNewCustomerRequests <= 100000 &&
             data.active is bool &&
             data.createdBy is string && isValidId(data.createdBy) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSalesEntry(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
             data.quotaId is string && isValidId(data.quotaId) &&
             data.dateString is string && data.dateString.size() == 10 && data.dateString.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.globalSales is number && data.globalSales >= 0 && data.globalSales <= 100000000 &&
             data.creditSales is number && data.creditSales >= 0 && data.creditSales <= 100000000 &&
             data.newCustomers is int && data.newCustomers >= 0 && data.newCustomers <= 10000 &&
             data.appMaOperations is int && data.appMaOperations >= 0 && data.appMaOperations <= 10000 &&
             data.newCustomerRequests is int && data.newCustomerRequests >= 0 && data.newCustomerRequests <= 10000 &&
             data.notes is string && data.notes.size() <= 300 &&
             (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() >= 1 && data.attachmentName.size() <= 120)) &&
             (!('attachmentMimeType' in data) || (data.attachmentMimeType is string && data.attachmentMimeType.size() >= 1 && data.attachmentMimeType.size() <= 100)) &&
             (!('attachmentBase64' in data) || (data.attachmentBase64 is string && data.attachmentBase64.size() >= 50 && data.attachmentBase64.size() <= 700000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- Collection Rules ---

    // 1. User Profiles & Role Metadata
    match /users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'role', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'branchName', 'role', 'createdAt', 'updatedAt']) &&
                       (incoming().role == 'EMPLOYEE' || isBootstrappedAdmin());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (request.auth.uid == userId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'branchName', 'updatedAt'])) ||
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'branchName', 'role', 'updatedAt']))
                       );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // 2. Authoritative Admin Lookup Collection
    match /admins/{userId} {
      allow get: if isValidId(userId) && ((isSignedIn() && request.auth.uid == userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId) &&
                       isAdmin() &&
                       isValidAdminRecord(incoming()) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'email', 'grantedBy', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'grantedBy', 'createdAt']);

      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    // 3. Assigned Checklist Tasks (Daily & Extraordinary)
    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && (isAdmin() || (isSignedIn() && existing().assigneeId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.assigneeId == request.auth.uid);

      allow create: if isValidId(taskId) &&
                       isSignedIn() &&
                       isValidTask(incoming()) &&
                       incoming().status == 'PENDING' &&
                       incoming().hasPhotoEvidence == false &&
                       incoming().keys().hasAll([
                         'assigneeId', 'assigneeName', 'createdBy', 'title', 'description',
                         'taskType', 'priority', 'dueDate', 'status', 'hasPhotoEvidence',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'assigneeId', 'assigneeName', 'createdBy', 'title', 'description',
                         'taskType', 'priority', 'dueDate', 'dueTime', 'deadlineLabel',
                         'status', 'hasPhotoEvidence', 'evidenceId', 'completedAt',
                         'createdAt', 'updatedAt'
                       ]) &&
                       (
                         (isAdmin() && incoming().createdBy == request.auth.uid) ||
                         (
                           incoming().assigneeId == request.auth.uid &&
                           incoming().createdBy == request.auth.uid &&
                           incoming().taskType == 'DAILY' &&
                           incoming().priority == 'NORMAL' &&
                           incoming().title in [
                             'Apertura de piso y encendido de exhibición',
                             'Revisión de exhibición destacada',
                             'Cierre de caja y orden en módulo de crédito',
                             'Actualización de avance de ventas (2:00 p.m.)',
                             'Actualización de avance de ventas (6:00 p.m.)',
                             'Inventario',
                             'Checklist domingos',
                             'Checklist cajas',
                             'Exámenes'
                           ]
                         )
                       );

      allow update: if isValidId(taskId) &&
                       isSignedIn() &&
                       isValidTask(incoming()) &&
                       incoming().assigneeId == existing().assigneeId &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'assigneeName', 'title', 'description', 'taskType', 'priority',
                            'dueDate', 'dueTime', 'deadlineLabel',
                            'status', 'hasPhotoEvidence', 'evidenceId', 'completedAt', 'updatedAt'
                          ])) ||
                         (existing().assigneeId == request.auth.uid &&
                          existing().status == 'PENDING' &&
                          incoming().status == 'COMPLETED' &&
                          incoming().hasPhotoEvidence == true &&
                          ('evidenceId' in incoming()) &&
                          ('completedAt' in incoming()) &&
                          existsAfter(/databases/$(database)/documents/task_evidences/$(incoming().evidenceId)) &&
                          getAfter(/databases/$(database)/documents/task_evidences/$(incoming().evidenceId)).data.taskId == taskId &&
                          getAfter(/databases/$(database)/documents/task_evidences/$(incoming().evidenceId)).data.uploaderId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'hasPhotoEvidence', 'evidenceId', 'completedAt', 'updatedAt'
                          ]))
                       );

      allow delete: if isValidId(taskId) && isAdmin();
    }

    // 4. Private Task Photo Evidences (STRICTLY ADMIN-ONLY READS)
    match /task_evidences/{evidenceId} {
      allow get: if isValidId(evidenceId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(evidenceId) &&
                       isSignedIn() &&
                       isValidTaskEvidence(incoming()) &&
                       incoming().uploaderId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'taskId', 'uploaderId', 'uploaderName', 'taskTitle', 'imageBase64', 'capturedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'taskId', 'uploaderId', 'uploaderName', 'taskTitle', 'imageBase64', 'capturedAt'
                       ]) &&
                       exists(/databases/$(database)/documents/tasks/$(incoming().taskId)) &&
                       (isAdmin() || get(/databases/$(database)/documents/tasks/$(incoming().taskId)).data.assigneeId == request.auth.uid);

      allow update: if false;
      allow delete: if isValidId(evidenceId) && isAdmin();
    }

    // 5. Extraordinary Task Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isAdmin() || (isSignedIn() && existing().recipientId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.recipientId == request.auth.uid);

      allow create: if isValidId(notificationId) &&
                       isAdmin() &&
                       isValidNotification(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().acknowledged == false &&
                       incoming().keys().hasAll([
                         'recipientId', 'taskId', 'title', 'message', 'acknowledged',
                         'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'recipientId', 'taskId', 'title', 'message', 'acknowledged',
                         'createdBy', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isValidId(notificationId) &&
                       isSignedIn() &&
                       isValidNotification(incoming()) &&
                       incoming().recipientId == existing().recipientId &&
                       incoming().taskId == existing().taskId &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (existing().recipientId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['acknowledged', 'updatedAt']))
                       );

      allow delete: if isValidId(notificationId) && (isAdmin() || (isSignedIn() && existing().recipientId == request.auth.uid));
    }

    // 6. Biweekly Sales Quotas (Set every 2 weeks by Admin)
    match /biweekly_quotas/{quotaId} {
      allow get: if isValidId(quotaId) && isSignedIn();
      allow list: if isAdmin() || (isSignedIn() && resource.data.active == true);

      allow create: if isValidId(quotaId) &&
                       isAdmin() &&
                       isValidBiweeklyQuota(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().keys().hasAll([
                         'title', 'startDate', 'endDate', 'totalDays',
                         'targetGlobalSales', 'targetCreditSales', 'targetNewCustomers',
                         'targetAppMaOperations', 'targetNewCustomerRequests',
                         'active', 'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'startDate', 'endDate', 'totalDays',
                         'targetGlobalSales', 'targetCreditSales', 'targetNewCustomers',
                         'targetAppMaOperations', 'targetNewCustomerRequests',
                         'active', 'createdBy', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isValidId(quotaId) &&
                       isAdmin() &&
                       isValidBiweeklyQuota(incoming()) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'startDate', 'endDate', 'totalDays',
                         'targetGlobalSales', 'targetCreditSales', 'targetNewCustomers',
                         'targetAppMaOperations', 'targetNewCustomerRequests',
                         'active', 'updatedAt'
                       ]);

      allow delete: if isValidId(quotaId) && isAdmin();
    }

    // 7. Daily Close-of-Operations Sales Entries
    match /sales_entries/{entryId} {
      allow get: if isValidId(entryId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(entryId) &&
                       isSignedIn() &&
                       isValidSalesEntry(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       exists(/databases/$(database)/documents/biweekly_quotas/$(incoming().quotaId)) &&
                       incoming().keys().hasAll([
                         'userId', 'userName', 'quotaId', 'dateString',
                         'globalSales', 'creditSales', 'newCustomers',
                         'appMaOperations', 'newCustomerRequests',
                         'notes', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'userName', 'quotaId', 'dateString',
                         'globalSales', 'creditSales', 'newCustomers',
                         'appMaOperations', 'newCustomerRequests',
                         'notes', 'attachmentName', 'attachmentMimeType', 'attachmentBase64',
                         'createdAt', 'updatedAt'
                       ]);

      allow update: if isValidId(entryId) &&
                       isSignedIn() &&
                       isValidSalesEntry(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().quotaId == existing().quotaId &&
                       incoming().dateString == existing().dateString &&
                       incoming().createdAt == existing().createdAt &&
                       (isAdmin() || existing().userId == request.auth.uid) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'globalSales', 'creditSales', 'newCustomers',
                         'appMaOperations', 'newCustomerRequests',
                         'notes', 'attachmentName', 'attachmentMimeType', 'attachmentBase64',
                         'updatedAt'
                       ]);

      allow delete: if isValidId(entryId) && isAdmin();
    }
  }
}
